// Annex B.18 -- operator soup. Every operator the grammar reserves, in
// contexts where a greedy operator rule would merge two into one.
package operators_pkg {
    struct ops_s {
        int a, b, c;

        constraint arithmetic {
            a + b - c * a / b % c == a ** b;
            a = -b;
            a =- b;
            a = +b;
            a = ~b;
            !(a == b);
        }

        constraint comparison {
            a == b; a != b; a < b; a <= b; a > b; a >= b;
            (a < b) && (b > c);
            (a < b) || (b > c);
            a & b; a | b; a ^ b;
            a << 2; a >> 2;
        }

        constraint ranges {
            a in [1..7];
            b in [1, 3, 5..9];
            c in [0..'d15];
        }

        constraint implication {
            a > 0 -> b > 0;
            (a > 0) -> { b > 0; c > 0; }
            a > 0 iff b > 0;
        }

        constraint distribution {
            a dist { 0 := 1, [1..3] :/ 6, 4 := 2 };
        }

        constraint ternary {
            b == (a > 0 ? 1 : -1);
        }
    }

    function void assignments() {
        int x = 0;
        x += 1;
        x -= 1;
        x <<= 2;
        x >>= 2;
        x |= 1;
        x &= 1;
    }

    function void varargs(int... args) { }

    struct scopes_s {
        operators_pkg::ops_s inner;
        int v = operators_pkg::ops_s::a;
    }
}
