/*
 * Triple-quoted target templates with mustache expressions and control-flow
 * directives (Clause 4.7.1, Mantis8730/8356), plus the 3.1 activity forms
 * `replicate`, `symbol` and `yield`.
 */
package template_pkg {

    import executor_pkg::*;

    action gen_a {
        rand int count;
        rand bit[31:0] base_addr;
        string name;

        symbol setup_s {
            do init_a;
            do config_a;
        }

        activity {
            setup_s;
            replicate (i: count) {
                do write_a with { index == i; };
            }
            replicate (count) leg[]: parallel {
                do read_a;
            }
        }

        exec body C = """
            /* {{name}}: emitted {{count}} times */
            {% foreach (i : count) %}
            write32({{base_addr}} + {{i}} * 4, {{i}});
            {%%}
            {% if (count > 0) %}
            printf("wrote %d words\n", {{count}});
            {%%}
        """;

        exec header SV = """
            import uvm_pkg::*;
        """;
    }

    action init_a { }
    action config_a { }
    action write_a { rand int index; }
    action read_a { }

    function void pause() {
        yield;
    }

    // Target-file exec: the operand is a filename, not a language.
    component gen_c {
        exec file "out/manifest.txt" = """
            generated by {{name}}
        """;
    }
}
