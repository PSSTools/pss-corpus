/*
 * Triple-quoted target templates with mustache expressions and control-flow
 * directives (Clause 4.7.1, Mantis8730/8356), plus the 3.1 activity forms
 * `replicate`, `symbol` and `yield`.
 *
 * The actions are declared inside `component gen_c` because `package_body_item`
 * (B.1) admits only `abstract_action_declaration` -- a bare `action` at package
 * scope is a syntax error.  See PROVENANCE.md, "Completing LRM examples".
 */
package template_pkg {

    function void pause() {
        yield;
    }

    component gen_c {

        string name;

        action gen_a {
            rand int count;
            rand bit[31:0] base_addr;
            string name;

            symbol setup_s {
                do init_a;
                do config_a;
            }

            activity {
                setup_s;
                replicate (i: count) {
                    do write_a with { index == i; };
                }
                replicate (count) leg[]: parallel {
                    do read_a;
                }
            }

            exec body C = """
                /* {{name}}: emitted {{count}} times */
                {% foreach (i : count) %}
                write32({{base_addr}} + {{i}} * 4, {{i}});
                {%%}
                {% if (count > 0) %}
                printf("wrote %d words\n", {{count}});
                {%%}
            """;

            exec header SV = """
                import uvm_pkg::*;
            """;
        }

        action init_a { }
        action config_a { }
        action write_a { rand int index; }
        action read_a { }

        // Target-file exec: the operand is a filename, not a language.  B.7
        // cannot derive this (it gives component_body_item ::= ... | exec_block),
        // but Example 309 uses exactly this form -- see the note on
        // component_body_item in PSSParser.g4.
        exec file "out/manifest.txt" = """
            generated by {{name}}
        """;
    }
}
