// Transmit a block of memory, processor-driven.
//
// The DMA engine is not involved and is not mentioned: this action claims a
// memory block, the shift engine, and nothing else. That is what makes it the
// baseline the DMA-serviced path is worth comparing against.
import addr_reg_pkg::*;
import mem_pkg::*;
import spi_types_pkg::*;

extend component spi_c {

    action prog_write_a {
        input  mem_blk_s      src;
        input  spi_state_s    st;
        lock   spi_engine_s   eng;

        constraint style_c {
            st.configured;
            !st.cfg.dma_en;     // programmed: the processor moves the words
        }

        exec body {
            comp.program_write(make_handle_from_claim(src.mem),
                               (bit[32])src.mem.size);
        }
    }
}
