// The controller's half of a memory-to-SPI transfer serviced by the DMA.
//
// It consumes the stream that dma_c::mem2spi_a produces. Because the coupling
// is a `stream`, this action and that one begin together and neither can appear
// in a scenario without the other -- a stream has exactly one producer and
// exactly one consumer (§9.3.2). No activity has to say "run these two in
// parallel"; a scenario that tries to schedule them any other way has no
// solution.
//
// Note what this action does NOT reference: no memory block, no DMA channel.
// The controller does not know where the data is coming from -- it raises a
// request line when its FIFO has room, and something answers. Modelling it as a
// stream endpoint rather than as an action that reads memory is what keeps that
// true.
import mem_pkg::*;
import spi_types_pkg::*;

extend component spi_c {

    action dma_write_a {
        input  spi_data_s     data;
        input  spi_state_s    st;
        lock   spi_engine_s   eng;

        constraint style_c {
            st.configured;
            st.cfg.dma_en;      // the controller must be raising DMA requests
        }

        exec body {
            comp.dma_transfer(SPI_XFER_WRITE, data.nbytes);
        }
    }
}
