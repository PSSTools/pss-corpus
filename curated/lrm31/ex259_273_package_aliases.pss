// ex259_273_package_aliases.pss
//
// Package aliases (LRM 18.1.4, 18.3), modelled on PSS 3.1 Examples 259 and
// 273 and completed to a whole model.
//
// Demonstrates:
//   - an alias for a nested package, used to qualify a type; the alias and
//     the full name denote the same type (Example 259)
//   - two aliases that disambiguate same-named types (Example 259)
//   - an alias taking precedence over a wildcard import that makes a
//     package of the same name visible: `P2::s` is P3::P4::s, not
//     P1::P2::s (Example 273)
//
// Completed from the LRM: a pss_top that uses both examples' types.

package pkg1::a::b::c {
  struct my_s {}
}

package pkg2::d::e::f {
  struct my_s {}
}

package consumer_pkg {
  import pkg1::a::b::c as p1;
  import pkg2::d::e::f as p2;
  struct s {
    p1::my_s            v1_1;   // pkg1::a::b::c::my_s
    pkg1::a::b::c::my_s v1_2;   // the same type as v1_1
    p2::my_s            v2;     // pkg2::d::e::f::my_s
  }
}

package P1 {
  package P2 {
    struct s {}
  }
}

package P3 {
  package P4 {
    struct s {}
  }
}

component pss_top {
  import P1::*;
  import P3::P4 as P2;

  action test {
    P2::s f;                    // P3::P4::s
    consumer_pkg::s cs;
  }
}
