{
  "schema": "pss-corpus/model/1.0",
  "id": "flow.atomic.no_infer_inside.001",
  "rev": 1,
  "title": "An inferred producer never runs inside an atomic block",
  "level": "L3",
  "lrm": [
    "11.3.7",
    "18.2"
  ],
  "features": {
    "tests": [
      "flow.infer.buffer",
      "activity.atomic"
    ],
    "uses": [
      "exec.body",
      "std.message",
      "activity.seq",
      "activity.traverse.type",
      "rand.field.scalar"
    ]
  },
  "sources": [
    "test.pss"
  ],
  "run": {
    "root": "pss_top::t",
    "seeds": {
      "count": 8
    }
  },
  "expect": {
    "outcome": "ok"
  },
  "inference": {
    "allowed": true
  },
  "types": {
    "pss_top::cfg_s": {
      "kind": "buffer",
      "fields": {
        "v": "u8"
      }
    },
    "pss_top::config": {
      "kind": "action",
      "atomic": true,
      "component": "pss_top",
      "fields": {},
      "refs": {
        "o": {
          "dir": "output",
          "type": "pss_top::cfg_s"
        }
      }
    },
    "pss_top::A": {
      "kind": "action",
      "atomic": true,
      "component": "pss_top",
      "fields": {}
    },
    "pss_top::B": {
      "kind": "action",
      "atomic": true,
      "component": "pss_top",
      "fields": {},
      "refs": {
        "i": {
          "dir": "input",
          "type": "pss_top::cfg_s"
        }
      },
      "constraints": [
        {
          "pss": "i.v == 7",
          "smt": "(= |i.v| #x07)",
          "smt_source": "hand"
        }
      ]
    },
    "pss_top::t": {
      "kind": "action",
      "atomic": false,
      "component": "pss_top",
      "fields": {},
      "activity": {
        "seq": [
          {
            "do": "pss_top::A"
          },
          {
            "do": "pss_top::B"
          }
        ],
        "atomic": true
      }
    }
  }
}
