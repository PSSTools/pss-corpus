import std_pkg::*;

component pss_top {
  buffer buf_s { rand bit[8] v; }
  pool buf_s bp;
  bind bp *;

  action w1 {
    output buf_s o;
    constraint o.v < 10;
    exec body { message(NONE, "@@PSS-TRACE act pss_top::w1 o.v=%u", o.v); }
  }
  action w2 {
    output buf_s o;
    constraint o.v >= 10;
    exec body { message(NONE, "@@PSS-TRACE act pss_top::w2 o.v=%u", o.v); }
  }
  action read {
    input buf_s i;
    exec body { message(NONE, "@@PSS-TRACE act pss_top::read i.v=%u", i.v); }
  }

  // Inferred producers: any multiset of w1/w2 feeding the two reads.
  action t {
    activity {
      parallel {
        do read;
        do read;
      }
    }
  }
}
