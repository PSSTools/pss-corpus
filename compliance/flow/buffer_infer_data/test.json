          "pss": "i.v in [8..12]",
          "smt": "(and (bvuge |i.v| #x08) (bvule |i.v| #x0c))",
          "smt_source": "hand"
        }
      ]
    },
    "pss_top::t": {
      "kind": "action",
      "atomic": false,
      "component": "pss_top",
      "fields": {},
      "activity": {
        "seq": [
          {
            "do": "pss_top::write1"
