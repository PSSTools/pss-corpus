          "type": "pss_top::buf_s"
        }
      },
      "constraints": [
        {
          "pss": "o.v in [1..5]",
          "smt": "(and (bvuge |o.v| #x01) (bvule |o.v| #x05))",
          "smt_source": "hand"
        }
      ]
    },
    "pss_top::write2": {
      "kind": "action",
      "atomic": true,
      "component": "pss_top",
      "fields": {},
      "refs": {
        "o": {
          "dir": "output",
          "type": "pss_top::buf_s"
        }
      },
      "constraints": [
        {
          "pss": "o.v in [6..10]",
          "smt": "(and (bvuge |o.v| #x06) (bvule |o.v| #x0a))",
          "smt_source": "hand"
        }
      ]
    },
    "pss_top::read": {
      "kind": "action",
      "atomic": true,
      "component": "pss_top",
      "fields": {},
      "refs": {
