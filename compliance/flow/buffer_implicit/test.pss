import std_pkg::*;

component pss_top {
  buffer buf_s { rand bit[8] v; }
  pool buf_s bp;
  bind bp *;

  action P {
    output buf_s o;
    exec body { message(NONE, "@@PSS-TRACE act pss_top::P o.v=%u", o.v); }
  }
  action C {
    input buf_s i;
    exec body { message(NONE, "@@PSS-TRACE act pss_top::C i.v=%u", i.v); }
  }

  // No bind statement: c.i must still be the object p.o (one pool, one producer).
  action t {
    P p;
    C c;
    activity {
      p;
      c;
    }
  }
}
