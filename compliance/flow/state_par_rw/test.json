          "dir": "output",
          "type": "pss_top::st_s"
        }
      },
      "constraints": [
        {
          "pss": "o.s in [1..15]",
          "smt": "(bvuge |o.s| #x1)",
          "smt_source": "hand"
        }
      ],
      "body": {
        "seq": [
          {
            "chk": "SW.rung",
            "eq": {
              "k": 0
            }
          },
          {
            "chk": "SW.rung",
            "eq": {
              "k": 1
            }
          }
        ]
      }
    },
    "pss_top::SR": {
      "kind": "action",
      "atomic": true,
      "component": "pss_top",
      "fields": {},
      "refs": {
        "i": {
          "dir": "input",
          "type": "pss_top::st_s"
        }
