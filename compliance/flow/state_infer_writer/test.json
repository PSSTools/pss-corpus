{
  "schema": "pss-corpus/model/1.0",
  "id": "flow.state.infer_writer.001",
  "rev": 1,
  "title": "A state writer is inferred when the initial state cannot satisfy the reader",
  "level": "L3",
  "lrm": [
    "14.3",
    "18.2"
  ],
  "features": {
    "tests": [
      "flow.state",
      "flow.infer.state",
      "flow.state.initial"
    ],
    "uses": [
      "exec.body",
      "std.message",
      "activity.seq",
      "activity.traverse.type",
      "rand.field.scalar"
    ]
  },
  "sources": [
    "test.pss"
  ],
  "run": {
    "root": "pss_top::t",
    "seeds": {
      "count": 8
    }
  },
  "expect": {
    "outcome": "ok"
  },
  "inference": {
    "allowed": true
  },
  "types": {
    "pss_top::st_s": {
      "kind": "state",
      "fields": {
        "s": "u4"
      },
      "initial": [
        {
          "pss": "s == 0",
          "smt": "(= |s| #x0)",
          "smt_source": "hand"
        }
      ]
    },
    "pss_top::W": {
      "kind": "action",
      "atomic": true,
      "component": "pss_top",
      "fields": {},
      "refs": {
        "o": {
          "dir": "output",
          "type": "pss_top::st_s"
        }
      }
    },
    "pss_top::R": {
      "kind": "action",
      "atomic": true,
      "component": "pss_top",
      "fields": {},
      "refs": {
        "i": {
          "dir": "input",
          "type": "pss_top::st_s"
        }
      },
      "constraints": [
        {
          "pss": "i.s == 5",
          "smt": "(= |i.s| #x5)",
          "smt_source": "hand"
        }
      ]
    },
    "pss_top::t": {
      "kind": "action",
      "atomic": false,
      "component": "pss_top",
      "fields": {},
      "activity": {
        "seq": [
          {
            "do": "pss_top::R"
          }
        ]
      }
    }
  }
}
