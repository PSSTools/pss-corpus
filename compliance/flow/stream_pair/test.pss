import std_pkg::*;

component pss_top {
  stream str_s { rand bit[8] v; }
  pool str_s sp;
  bind sp *;

  action P {
    output str_s o;
    exec body { message(NONE, "@@PSS-TRACE act pss_top::P o.v=%u", o.v); }
  }
  action C {
    input str_s i;
    exec body { message(NONE, "@@PSS-TRACE act pss_top::C i.v=%u", i.v); }
  }

  // A stream (14.4) binds a producer and a consumer that run in parallel:
  // c.i reads the object p.o writes, on every seed.
  action t {
    P p;
    C c;
    activity {
      parallel {
        p;
        c;
      }
      bind p.o c.i;
    }
  }
}
