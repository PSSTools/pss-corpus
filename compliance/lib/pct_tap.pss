// The executor tap (COMPLIANCE-DESIGN.md §4.12).
//
// An executor that overrides every primitive memory access (LRM 21.13.9.5).
// Each access is logged as an `acc` trace record, and each read is answered
// with a value computed from its address alone:
//
//     a read of N bytes at `a` returns F8(a), F8(a+1), ... F8(a+N-1),
//     the first byte in bits [7:0] (LRM 21.13.9.1)
//
// where F8 is the XOR of the address's eight bytes, XOR 0x5A. The tap holds no
// state -- a component's attributes may be set only while the tree is built --
// so a read never sees a write; the write records say what was written.
//
// A test compiles this file by listing it in its model ("libs": ["pct_tap"])
// and assigns the tap in its root component:
//
//     pct_tap_executor_c tap;
//     exec init_down { set_executor(tap); }
//
// Sub-components inherit the executor (LRM 21.7.2.6), so that one call covers
// the tree. Register accesses are defined in terms of the primitives, so they
// reach the tap too.
//
// Deliberately small: executor delegation, set_executor, message, shifts, XOR
// and explicit casts. No loops, no collections, no state. `addr_value` is not
// overridden -- address resolution is the tool's, and stays under test. The
// checker computes F8 itself (checker/src/pss_corpus/tap.py): a read record
// whose data is not F8 of its address fails, so a tool that miscompiles this
// file cannot feed its own values to a test.

import std_pkg::*;
import addr_reg_pkg::*;
import executor_pkg::*;

// One byte per address.
function bit[8] pct_f8(bit[64] a) {
  bit[64] x = a ^ (a >> 32);
  x = x ^ (x >> 16);
  x = x ^ (x >> 8);
  return (bit[8])(x ^ 0x5A);
}

component pct_tap_executor_c : executor_c<> {

  target function bit[8] read8(addr_handle_t hndl,
                               mem_access_desc_s mem_access_desc = {}) {
    bit[64] a = addr_value(hndl);
    bit[8] v = pct_f8(a);
    message(NONE, "@@PSS-TRACE acc r8 addr=0x%x data=0x%x", a, v);
    return v;
  }

  target function bit[16] read16(addr_handle_t hndl,
                                 mem_access_desc_s mem_access_desc = {}) {
    bit[64] a = addr_value(hndl);
    bit[16] v = ((bit[16])pct_f8(a))
              | (((bit[16])pct_f8(a + 1)) << 8);
    message(NONE, "@@PSS-TRACE acc r16 addr=0x%x data=0x%x", a, v);
    return v;
  }

  target function bit[32] read32(addr_handle_t hndl,
                                 mem_access_desc_s mem_access_desc = {}) {
    bit[64] a = addr_value(hndl);
    bit[32] v = ((bit[32])pct_f8(a))
              | (((bit[32])pct_f8(a + 1)) << 8)
              | (((bit[32])pct_f8(a + 2)) << 16)
              | (((bit[32])pct_f8(a + 3)) << 24);
    message(NONE, "@@PSS-TRACE acc r32 addr=0x%x data=0x%x", a, v);
    return v;
  }

  target function bit[64] read64(addr_handle_t hndl,
                                 mem_access_desc_s mem_access_desc = {}) {
    bit[64] a = addr_value(hndl);
    bit[64] v = ((bit[64])pct_f8(a))
              | (((bit[64])pct_f8(a + 1)) << 8)
              | (((bit[64])pct_f8(a + 2)) << 16)
              | (((bit[64])pct_f8(a + 3)) << 24)
              | (((bit[64])pct_f8(a + 4)) << 32)
              | (((bit[64])pct_f8(a + 5)) << 40)
              | (((bit[64])pct_f8(a + 6)) << 48)
              | (((bit[64])pct_f8(a + 7)) << 56);
    message(NONE, "@@PSS-TRACE acc r64 addr=0x%x data=0x%x", a, v);
    return v;
  }

  target function void write8(addr_handle_t hndl, bit[8] data,
                              mem_access_desc_s mem_access_desc = {}) {
    message(NONE, "@@PSS-TRACE acc w8 addr=0x%x data=0x%x",
            addr_value(hndl), data);
  }

  target function void write16(addr_handle_t hndl, bit[16] data,
                               mem_access_desc_s mem_access_desc = {}) {
    message(NONE, "@@PSS-TRACE acc w16 addr=0x%x data=0x%x",
            addr_value(hndl), data);
  }

  target function void write32(addr_handle_t hndl, bit[32] data,
                               mem_access_desc_s mem_access_desc = {}) {
    message(NONE, "@@PSS-TRACE acc w32 addr=0x%x data=0x%x",
            addr_value(hndl), data);
  }

  target function void write64(addr_handle_t hndl, bit[64] data,
                               mem_access_desc_s mem_access_desc = {}) {
    message(NONE, "@@PSS-TRACE acc w64 addr=0x%x data=0x%x",
            addr_value(hndl), data);
  }
}
