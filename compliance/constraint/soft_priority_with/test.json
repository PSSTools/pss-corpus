{
  "schema": "pss-corpus/model/1.0",
  "id": "constraint.soft_priority_with.001",
  "rev": 1,
  "title": "A soft constraint in `with` is kept over the traversed type's conflicting soft constraint",
  "level": "L2",
  "lrm": [
    "16.1.12",
    "13.3.1"
  ],
  "features": {
    "tests": [
      "constraint.soft.priority.with"
    ],
    "uses": [
      "exec.body",
      "std.message",
      "rand.field.scalar",
      "constraint.soft",
      "activity.traverse.type",
      "activity.traverse.with"
    ]
  },
  "sources": [
    "test.pss"
  ],
  "run": {
    "root": "pss_top::T",
    "seeds": {
      "count": 16
    }
  },
  "expect": {
    "outcome": "ok"
  },
  "types": {
    "pss_top::A": {
      "kind": "action",
      "atomic": true,
      "component": "pss_top",
      "fields": {
        "v": "u4",
        "w": "u4"
      },
      "constraints": [
        {
          "pss": "w == 3",
          "smt": "(= w #x3)",
          "smt_source": "hand"
        }
      ]
    },
    "pss_top::T": {
      "kind": "action",
      "atomic": false,
      "component": "pss_top",
      "fields": {},
      "constraints": [],
      "activity": {
        "seq": [
          {
            "do": "pss_top::A",
            "with": [
              {
                "pss": "v == 5",
                "smt": "(= v #x5)",
                "smt_source": "hand"
              }
            ]
          }
        ]
      }
    }
  }
