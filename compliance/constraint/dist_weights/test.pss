import std_pkg::*;

// LRM 16.1.11: `:=` gives every value of an item the same weight, so here 0
// has weight 40 and each of 1, 2 and 3 has weight 60 (0 is picked 40/220 of
// the time). A dist is also a hard constraint: x is never above 3.
component pss_top {
  action A {
    rand bit[4] x;
    constraint {
      dist x in [0 := 40, 1..3 := 60];
    }
    exec body { message(NONE, "@@PSS-TRACE act pss_top::A x=%u", x); }
  }
}
