import std_pkg::*;

component pss_top {
  resource rs_s { }
  pool[1] rs_s rp;
  bind rp *;

  action S {
    share rs_s r;
    exec body { message(NONE, "@@PSS-TRACE act pss_top::S r.instance_id=%u", r.instance_id); }
  }

  action t {
    activity {
      parallel {
        do S;
        do S;
        do S;
      }
    }
  }
}
