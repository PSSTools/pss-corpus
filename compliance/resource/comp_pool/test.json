{
  "schema": "pss-corpus/model/1.0",
  "id": "resource.comp.pool.001",
  "rev": 1,
  "title": "Actions of a sub-component lock resources from that component's pool",
  "level": "L3",
  "lrm": [
    "15.2",
    "17.1",
    "17.2"
  ],
  "features": {
    "tests": [
      "resource.pool",
      "resource.pool.bind.component"
    ],
    "uses": [
      "exec.body",
      "std.message",
      "activity.seq",
      "activity.traverse.handle",
      "rand.field.scalar"
    ]
  },
  "sources": [
    "test.pss"
  ],
  "run": {
    "root": "pss_top::t",
    "seeds": {
      "count": 8
    }
  },
  "expect": {
    "outcome": "ok"
  },
  "types": {
    "sub_c::L": {
      "kind": "action",
      "atomic": true,
      "component": "sub_c",
      "fields": {
        "r.instance_id": "u32"
      },
      "constraints": [
        {
          "pss": "r.instance_id < 3",
          "smt": "(bvult |r.instance_id| #x00000003)",
          "smt_source": "hand"
        }
      ]
    },
    "pss_top::t": {
      "kind": "action",
      "atomic": false,
      "component": "pss_top",
      "fields": {},
      "constraints": [
        {
          "pss": "a.r.instance_id != b.r.instance_id",
          "smt": "(not (= |a.r.instance_id| |b.r.instance_id|))",
          "smt_source": "hand"
        }
      ],
      "activity": {
        "seq": [
          {
            "do": "sub_c::L",
            "label": "a"
          },
          {
            "do": "sub_c::L",
            "label": "b"
          }
        ]
      }
    }
  }
}
