{
  "schema": "pss-corpus/model/1.0",
  "id": "resource.rand_attr.001",
  "rev": 1,
  "title": "An action's constraint on a resource attribute selects a matching instance",
  "level": "L3",
  "lrm": [
    "15.1",
    "15.2"
  ],
  "features": {
    "tests": [
      "resource.attr.rand",
      "resource.lock"
    ],
    "uses": [
      "exec.body",
      "std.message",
      "activity.seq",
      "activity.traverse.handle",
      "rand.field.scalar",
      "constraint.expr"
    ]
  },
  "sources": [
    "test.pss"
  ],
  "run": {
    "root": "pss_top::t",
    "seeds": {
      "count": 8
    }
  },
  "expect": {
    "outcome": "ok"
  },
  "types": {
    "pss_top::L": {
      "kind": "action",
      "atomic": true,
      "component": "pss_top",
      "fields": {
        "r.attr": "u4",
        "r.instance_id": "u32"
      },
      "constraints": [
        {
          "pss": "r.attr == 1",
          "smt": "(= |r.attr| #x1)",
          "smt_source": "hand"
        },
        {
          "pss": "r.instance_id < 4",
          "smt": "(bvult |r.instance_id| #x00000004)",
          "smt_source": "hand"
        }
      ]
    },
    "pss_top::t": {
      "kind": "action",
      "atomic": false,
      "component": "pss_top",
      "fields": {},
      "activity": {
        "seq": [
          {
            "do": "pss_top::L",
            "label": "a"
          }
        ]
      }
    }
  }
}
