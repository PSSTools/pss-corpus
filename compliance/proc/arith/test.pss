import std_pkg::*;

component pss_top {
  action A {
    exec body {
      message(NONE, "@@PSS-TRACE act pss_top::A");
      int a = 17;
      int b = 5;
      message(NONE, "@@PSS-TRACE chk arith add=%d sub=%d mul=%d div=%d mod=%d neg=%d",
              a + b, a - b, a * b, a / b, a % b, -a);
    }
  }
}
