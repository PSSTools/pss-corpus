import std_pkg::*;

component pss_top {
  action A {
    exec body {
      message(NONE, "@@PSS-TRACE act pss_top::A");
      int a;
      a = 3;
      match (a) {
        [1, 3]: message(NONE, "@@PSS-TRACE chk mv.odd a=%d", a);
        [2, 4]: message(NONE, "@@PSS-TRACE chk mv.even a=%d", a);
      }
      a = 4;
      match (a) {
        [1, 3]: message(NONE, "@@PSS-TRACE chk mv.odd a=%d", a);
        [2, 4]: message(NONE, "@@PSS-TRACE chk mv.even a=%d", a);
      }
    }
  }
}
