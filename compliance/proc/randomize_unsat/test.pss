import std_pkg::*;

// LRM 22.7.8: a `randomize x with { ... }` whose constraints cannot all hold
// is an error. The run stops there, and the error names the statement.
component pss_top {
  action A {
    exec body {
      bit[8] x;
      message(NONE, "@@PSS-TRACE chk before");
      randomize x with { x > 10; x < 5; };
      message(NONE, "@@PSS-TRACE chk after x=%u", x);
    }
  }
}
