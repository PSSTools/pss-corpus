import std_pkg::*;

component pss_top {
  action A {
    exec body {
      message(NONE, "@@PSS-TRACE act pss_top::A");
      int n = 0;
      repeat (4) {
        n += 1;
        message(NONE, "@@PSS-TRACE chk rep n=%d", n);
      }
      message(NONE, "@@PSS-TRACE chk rep.done n=%d", n);
    }
  }
}
