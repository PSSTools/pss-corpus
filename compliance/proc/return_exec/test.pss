import std_pkg::*;

component pss_top {
  action A {
    exec body {
      message(NONE, "@@PSS-TRACE act pss_top::A");
      int x = 1;
      message(NONE, "@@PSS-TRACE chk ret.before x=%d", x);
      if (x == 1) {
        return;
      }
      message(NONE, "@@PSS-TRACE chk ret.wrong x=%d", x);
    }
  }
}
