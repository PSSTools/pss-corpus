import std_pkg::*;

struct params_s {
  int x;
  int y;
}

function void set_val0(params_s p, int a) {
  p.x = a;
  a = 0;
}

function void set_val1(params_s dst, params_s src) {
  dst.x = src.x;
}

function params_s make(int v) {
  params_s s;
  s.x = v;
  s.y = v + 1;
  return s;
}

component pss_top {
  target function void fill(params_s p, int v) {
    p.y = v;
  }

  action A {
    exec body {
      message(NONE, "@@PSS-TRACE act pss_top::A");
      params_s p;
      int a = 10;
      p.x = 20;
      p.y = 7;
      set_val0(p, a);
      message(NONE, "@@PSS-TRACE chk sp0 px=%d py=%d a=%d", p.x, p.y, a);
      set_val1(p, make(-4));
      message(NONE, "@@PSS-TRACE chk sp1 px=%d py=%d", p.x, p.y);
      comp.fill(p, 77);
      message(NONE, "@@PSS-TRACE chk sp2 px=%d py=%d", p.x, p.y);
    }
  }
}
