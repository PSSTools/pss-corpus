{
  "schema": "pss-corpus/model/1.0",
  "id": "cov.options.001",
  "rev": 1,
  "title": "Covergroup options are accepted wherever they may be written and change no hit count",
  "level": "L3",
  "lrm": [
    "19.6"
  ],
  "features": {
    "tests": [
      "coverage.option"
    ],
    "uses": [
      "exec.body",
      "std.message",
      "activity.seq",
      "activity.traverse.type",
      "rand.field.scalar",
      "coverage.covergroup.type",
      "coverage.covergroup.inline.action",
      "coverage.bins.range"
    ]
  },
  "sources": [
    "test.pss"
  ],
  "run": {
    "root": "pss_top::B",
    "seeds": {
      "count": 8
    }
  },
  "expect": {
    "outcome": "ok",
    "coverage": [
      {
        "covergroup": "cg_t",
        "samples": 3
      },
      {
        "covergroup": "cg_t",
        "coverpoint": "cp_v",
        "bin": "lo",
        "hits": 2
      },
      {
        "covergroup": "cg_t",
        "coverpoint": "cp_v",
        "bin": "hi",
        "hits": 1
      },
      {
        "covergroup": "pss_top::A::cs",
        "samples": 3
      },
      {
        "covergroup": "pss_top::A::cs",
        "coverpoint": "cp_a",
        "bin": "lo",
        "hits": 2
      },
      {
        "covergroup": "pss_top::A::cs",
        "coverpoint": "cp_a",
        "bin": "hi",
        "hits": 1
      }
    ]
  },
  "types": {
    "pss_top::A": {
      "kind": "action",
      "atomic": true,
      "component": "pss_top",
      "fields": {
        "a": "u2"
      }
    },
    "pss_top::B": {
      "kind": "action",
      "atomic": false,
      "component": "pss_top",
      "fields": {},
      "constraints": [],
      "activity": {
        "seq": [
          {
            "do": "pss_top::A",
            "with": [
              {
                "pss": "a == 0",
                "smt": "(= a #b00)",
                "smt_source": "hand"
              }
            ]
          },
          {
            "do": "pss_top::A",
            "with": [
              {
                "pss": "a == 1",
                "smt": "(= a #b01)",
                "smt_source": "hand"
              }
            ]
          },
          {
            "do": "pss_top::A",
            "with": [
              {
                "pss": "a == 3",
                "smt": "(= a #b11)",
                "smt_source": "hand"
              }
            ]
          }
        ]
      }
    }
  }
}
