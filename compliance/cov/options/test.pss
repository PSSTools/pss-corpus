import std_pkg::*;

// LRM 19.6: covergroup options, set in a covergroup type, in a coverpoint, in
// an instance's `with` block and in an inline covergroup, are accepted and
// change no hit count (they change only how coverage is graded).
// B traverses A with a = 0, 1, 3.
covergroup cg_t(bit[2] v) {
  option.at_least = 2;
  cp_v: coverpoint v { option.weight = 2; bins lo = [0..1]; bins hi = [2..3]; }
}

component pss_top {
  action A {
    rand bit[2] a;
    exec body { message(NONE, "@@PSS-TRACE act pss_top::A a=%u", a); }
    cg_t ct(a) with { option.weight = 3; option.goal = 50; };
    covergroup {
      option.per_instance = true;
      cp_a: coverpoint a { option.at_least = 2; bins lo = [0..1]; bins hi = [2..3]; }
    } cs;
  }

  action B {
    activity {
      do A with { a == 0; };
      do A with { a == 1; };
      do A with { a == 3; };
    }
  }
}
