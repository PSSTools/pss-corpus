{
  "schema": "pss-corpus/model/1.0",
  "id": "cov.cross.001",
  "rev": 1,
  "title": "A cross of two coverpoints counts each pair of bins hit together",
  "level": "L3",
  "lrm": [
    "19.4"
  ],
  "features": {
    "tests": [
      "coverage.cross"
    ],
    "uses": [
      "exec.body",
      "std.message",
      "activity.seq",
      "activity.traverse.type",
      "rand.field.scalar",
      "coverage.covergroup.inline.action",
      "coverage.bins.range"
    ]
  },
  "sources": [
    "test.pss"
  ],
  "run": {
    "root": "pss_top::B",
    "seeds": {
      "count": 8
    }
  },
  "expect": {
    "outcome": "ok",
    "coverage": [
      {
        "covergroup": "pss_top::A::cs",
        "samples": 3
      },
      {
        "covergroup": "pss_top::A::cs",
        "cross": "ab",
        "bins": [
          "lo",
          "z"
        ],
        "hits": 2
      },
      {
        "covergroup": "pss_top::A::cs",
        "cross": "ab",
        "bins": [
          "hi",
          "o"
        ],
        "hits": 1
      },
      {
        "covergroup": "pss_top::A::cs",
        "cross": "ab",
        "bins": [
          "lo",
          "o"
        ],
        "hits": 0
      },
      {
        "covergroup": "pss_top::A::cs",
        "cross": "ab",
        "bins": [
          "hi",
          "z"
        ],
        "hits": 0
      }
    ]
  },
  "types": {
    "pss_top::A": {
      "kind": "action",
      "atomic": true,
      "component": "pss_top",
      "fields": {
        "a": "u2",
        "b": "u1"
      }
    },
    "pss_top::B": {
      "kind": "action",
      "atomic": false,
      "component": "pss_top",
      "fields": {},
      "constraints": [],
      "activity": {
        "seq": [
          {
            "do": "pss_top::A",
            "with": [
              {
                "pss": "a == 0",
                "smt": "(= a #b00)",
                "smt_source": "hand"
              },
              {
                "pss": "b == 0",
                "smt": "(= b #b0)",
                "smt_source": "hand"
              }
            ]
          },
          {
            "do": "pss_top::A",
            "with": [
              {
                "pss": "a == 1",
                "smt": "(= a #b01)",
                "smt_source": "hand"
              },
              {
                "pss": "b == 0",
                "smt": "(= b #b0)",
                "smt_source": "hand"
              }
            ]
          },
          {
            "do": "pss_top::A",
            "with": [
              {
                "pss": "a == 3",
                "smt": "(= a #b11)",
                "smt_source": "hand"
              },
              {
                "pss": "b == 1",
                "smt": "(= b #b1)",
                "smt_source": "hand"
              }
            ]
          }
        ]
      }
    }
  }
}
