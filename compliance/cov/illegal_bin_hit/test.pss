import std_pkg::*;

// LRM 19.3.4: sampling a value in an illegal bin is a run-time error, reported
// at the illegal bin. B traverses A with a = 0, then a = 3 (illegal).
component pss_top {
  action A {
    rand bit[2] a;
    exec body { message(NONE, "@@PSS-TRACE act pss_top::A a=%u", a); }
    covergroup {
      cp_a: coverpoint a {
        bins ok = [0..2];
        illegal_bins bad = [3];
      }
    } cs;
  }

  action B {
    activity {
      do A with { a == 0; };
      do A with { a == 3; };
    }
  }
}
