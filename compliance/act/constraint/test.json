{
  "schema": "pss-corpus/model/1.0",
  "id": "act.constraint.001",
  "rev": 1,
  "title": "An activity constraint holds in its block, and earlier traversals look ahead to it",
  "level": "L3",
  "lrm": [
    "13.1.9",
    "13.4.9"
  ],
  "features": {
    "tests": [
      "activity.constraint"
    ],
    "uses": [
      "exec.body",
      "std.message",
      "activity.seq",
      "activity.block",
      "activity.traverse.handle",
      "rand.field.scalar"
    ]
  },
  "sources": [
    "test.pss"
  ],
  "run": {
    "root": "pss_top::T",
    "seeds": {
      "count": 64
    }
  },
  "expect": {
    "outcome": "ok"
  },
  "types": {
    "pss_top::A": {
      "kind": "action",
      "atomic": true,
      "component": "pss_top",
      "fields": {
        "val": "u4"
      }
    },
    "pss_top::T": {
      "kind": "action",
      "atomic": false,
      "component": "pss_top",
      "fields": {},
      "constraints": [],
      "activity": {
        "seq": [
          {
            "do": "pss_top::A",
            "label": "a"
          },
          {
            "seq": [
              {
                "do": "pss_top::A",
                "label": "b"
              },
              {
                "constraint": [
                  {
                    "pss": "b.val > a.val",
                    "smt": "(bvugt |b.val| |a.val|)",
                    "smt_source": "hand"
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
