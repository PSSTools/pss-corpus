import std_pkg::*;

// LRM Example 184 (13.4.10). v.val is chosen before s1 is traversed, yet
// must be < 14: s1.a.val == v.val, and s1's own constraint needs room above
// s1.a.val for s1.b.val and s1.c.val.
component pss_top {
  action A {
    rand bit[4] val;
    exec body { message(NONE, "@@PSS-TRACE act pss_top::A val=%u", val); }
  }

  action sub {
    A a, b, c;
    constraint abc_c {
      a.val < b.val;
      b.val < c.val;
    }
    activity {
      a;
      b;
      c;
    }
  }

  action top_action {
    A v;
    sub s1;
    constraint c {
      s1.a.val == v.val;
    }
    activity {
      v;
      s1;
    }
  }
}
