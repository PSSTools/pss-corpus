{
  "schema": "pss-corpus/model/1.0",
  "id": "act.join_branch.001",
  "rev": 1,
  "title": "parallel join_branch joins only the named branch; every branch still runs once",
  "level": "L3",
  "lrm": [
    "13.3.6"
  ],
  "features": {
    "tests": [
      "activity.parallel",
      "activity.join.branch"
    ],
    "uses": [
      "exec.body",
      "std.message",
      "activity.seq",
      "activity.traverse.handle",
      "rand.field.scalar"
    ]
  },
  "sources": [
    "test.pss"
  ],
  "run": {
    "root": "pss_top::t",
    "seeds": {
      "count": 8
    }
  },
  "expect": {
    "outcome": "ok"
  },
  "types": {
    "pss_top::A": {
      "kind": "action",
      "atomic": true,
      "component": "pss_top",
      "fields": {
        "x": "u8"
      }
    },
    "pss_top::B": {
      "kind": "action",
      "atomic": true,
      "component": "pss_top",
      "fields": {
        "x": "u8"
      }
    },
    "pss_top::C": {
      "kind": "action",
      "atomic": true,
      "component": "pss_top",
      "fields": {
        "x": "u8"
      }
    },
    "pss_top::t": {
      "kind": "action",
      "atomic": false,
      "component": "pss_top",
      "fields": {},
      "activity": {
        "seq": [
          {
            "par": [
              {
                "do": "pss_top::A",
                "label": "a"
              },
              {
                "do": "pss_top::B",
                "label": "b"
              }
            ],
            "join": "branch:a"
          },
          {
            "do": "pss_top::C",
            "label": "d"
          }
        ]
      }
    }
  }
}
