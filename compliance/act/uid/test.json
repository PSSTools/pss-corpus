{
  "schema": "pss-corpus/model/1.0",
  "id": "act.uid.001",
  "rev": 1,
  "title": "Each action traversal has its own uid, readable in exec bodies and constraints",
  "level": "L3",
  "lrm": [
    "9"
  ],
  "features": {
    "tests": [
      "action.uid"
    ],
    "uses": [
      "exec.body",
      "std.message",
      "activity.seq",
      "activity.repeat",
      "activity.traverse.handle",
      "rand.field.scalar"
    ]
  },
  "sources": [
    "test.pss"
  ],
  "run": {
    "root": "pss_top::t",
    "seeds": {
      "count": 8
    }
  },
  "expect": {
    "outcome": "ok"
  },
  "types": {
    "pss_top::A": {
      "kind": "action",
      "atomic": true,
      "component": "pss_top",
      "fields": {
        "uid": "u32"
      }
    },
    "pss_top::B": {
      "kind": "action",
      "atomic": true,
      "component": "pss_top",
      "fields": {
        "t": "u32",
        "uid": "u32"
      }
    },
    "pss_top::t": {
      "kind": "action",
      "atomic": false,
      "component": "pss_top",
      "fields": {},
      "constraints": [
        {
          "pss": "b.t == a1.uid + 100",
          "smt": "(= |b.t| (bvadd |a1.uid| #x00000064))",
          "smt_source": "hand"
        }
      ],
      "activity": {
        "seq": [
          {
            "do": "pss_top::A",
            "label": "a1"
          },
          {
            "repeat": {
              "count": 3
            },
            "body": {
              "do": "pss_top::A"
            }
          },
          {
            "do": "pss_top::B",
            "label": "b"
          }
        ]
      }
    }
  }
}
