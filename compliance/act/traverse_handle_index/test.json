{
  "schema": "pss-corpus/model/1.0",
  "id": "act.traverse.handle.index.001",
  "rev": 1,
  "title": "A handle-array element picked by a computed or random index is traversed",
  "level": "L3",
  "lrm": [
    "12.3.2"
  ],
  "features": {
    "tests": [
      "activity.traverse.handle.index"
    ],
    "uses": [
      "exec.body",
      "std.message",
      "activity.repeat",
      "rand.field.scalar"
    ]
  },
  "sources": [
    "test.pss"
  ],
  "run": {
    "root": "pss_top::T",
    "seeds": {
      "count": 8
    }
  },
  "expect": {
    "outcome": "ok"
  },
  "types": {
    "pss_top::A": {
      "kind": "action",
      "atomic": true,
      "component": "pss_top",
      "fields": {
        "x": "u8"
      }
    },
    "pss_top::T": {
      "kind": "action",
      "atomic": false,
      "component": "pss_top",
      "fields": {},
      "activity": {
        "seq": [
          {
            "do": "pss_top::A",
            "with": [
              {
                "pss": "x == 3",
                "smt": "(= x #x03)",
                "smt_source": "hand"
              }
            ]
          },
          {
            "do": "pss_top::A",
            "with": [
              {
                "pss": "x == 2",
                "smt": "(= x #x02)",
                "smt_source": "hand"
              }
            ]
          },
          {
            "do": "pss_top::A",
            "with": [
              {
                "pss": "x == 1",
                "smt": "(= x #x01)",
                "smt_source": "hand"
              }
            ]
          },
          {
            "select": [
              {
                "body": {
                  "do": "pss_top::A",
                  "with": [
                    {
                      "pss": "x == 1",
                      "smt": "(= x #x01)",
                      "smt_source": "hand"
                    }
                  ]
                }
              },
              {
                "body": {
                  "do": "pss_top::A",
                  "with": [
                    {
                      "pss": "x == 2",
                      "smt": "(= x #x02)",
                      "smt_source": "hand"
                    }
                  ]
                }
              },
              {
                "body": {
                  "do": "pss_top::A",
                  "with": [
                    {
                      "pss": "x == 3",
                      "smt": "(= x #x03)",
                      "smt_source": "hand"
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  }
}
