import std_pkg::*;
import sync_pkg::*;

component pss_top {
  channel_c<bit[8], 1> c;

  action A {
    exec body {
      message(NONE, "@@PSS-TRACE act pss_top::A");
      bit[8] t = 0x77;
      bool g0 = comp.c.try_get(t);
      bool p1 = comp.c.try_put(0x5a);
      bool p2 = comp.c.try_put(0x33);
      bool g1 = comp.c.try_get(t);
      message(NONE, "@@PSS-TRACE chk ct g0=%n p1=%n p2=%n g1=%n t=0x%x", g0, p1, p2, g1, t);
      bool g2 = comp.c.try_get(t);
      bool p3 = comp.c.try_put(0x33);
      message(NONE, "@@PSS-TRACE chk ce g2=%n p3=%n", g2, p3);
    }
  }
}
